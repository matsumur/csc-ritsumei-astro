---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchSubNav from '../components/ResearchSubNav.astro';
import publications from '../data/publications.json';
---
<BaseLayout title="先端認知科学研究センター：刊行物" activeNav="resarch">
  <ResearchSubNav activeTab="publication" />

  <h3>刊行物</h3>
  <ol>
    {publications.map((pub) => (
      <li>{pub}</li>
    ))}
  </ol>
</BaseLayout>
