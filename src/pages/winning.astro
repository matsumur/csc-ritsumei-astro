---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchSubNav from '../components/ResearchSubNav.astro';
import awards from '../data/winning.json';
---
<BaseLayout title="先端認知科学研究センター：受賞" activeNav="resarch">
  <ResearchSubNav activeTab="winning" />

  <h3>これまでの受賞経歴</h3>
  <ol>
    {awards.map((award) => (
      <li>{award}</li>
    ))}
  </ol>
</BaseLayout>
