---
import BaseLayout from '../layouts/BaseLayout.astro';
import newsData from '../data/news.json';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (p: string) => `${base}${p.replace(/^\/+/, '')}`;
---
<BaseLayout title="認知科学研究センター：新着情報" activeNav="news">
  <h2><a id="topics" class="inner">ニュース</a></h2>
  <ol>
    {newsData.latestNews.map((item) => (
      <li>
        <p>
          {item.date}，{item.venue}にて，{item.title}
        </p>
        <ul>
          {item.presentations.map((pres) => (
            <li>{pres}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <h2><a id="upcoming" class="inner">今後の研究会</a></h2>
  <ol>
    <li>{newsData.upcomingInfo}</li>
  </ol>

  <div style="margin-top: 28px; padding: 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;">
    <strong>関連ページのご案内：</strong>
    <a href={withBase('home.html')}>本研究センターの意義と目的（ホーム）</a> ／
    <a href={withBase('seminar.html')}>過去の研究会の記録（第1回〜第52回）</a>
  </div>
</BaseLayout>
